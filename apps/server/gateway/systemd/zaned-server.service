[Unit]
Description=Zaned server (tick-service subsystem + WS fanout, /health endpoint)
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/zaned-server
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30
EnvironmentFile=/etc/zaned-server.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
