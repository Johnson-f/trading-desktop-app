# Copy to apps/historical-service/.env (gitignored) and fill in real values.
# `cargo run -p historical-service` will auto-load this via dotenvy.

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_DATABASE=market_data

# Optional
# SCHEDULE_HOUR_UTC=2
# YAHOO_WORKERS=8
# RUST_LOG=historical_service=info,markets=warn
