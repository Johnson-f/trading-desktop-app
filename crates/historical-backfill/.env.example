# R2 Data Catalog (Apache Iceberg REST)
# Generated via `wrangler r2 bucket catalog enable <bucket>`.
WAREHOUSE_CATALOG_URI=https://catalog.cloudflarestorage.com/REPLACE_ME/zaned-warehouse
WAREHOUSE_NAME=REPLACE_ME_zaned-warehouse
WAREHOUSE_TOKEN=REPLACE_ME_with_r2_api_token

# Iceberg namespace inside the warehouse. Default is fine.
WAREHOUSE_NAMESPACE=market_data

# Scheduler — unchanged from ClickHouse era.
SCHEDULE_HOUR_UTC=2
YAHOO_WORKERS=8
RUST_LOG=historical_backfill=info,markets=warn
